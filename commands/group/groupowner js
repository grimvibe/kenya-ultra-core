import Reply from "../../utils/reply.js";

export default {

    name: "groupowner",

    description: "Show who owns this group.",

    category: "Group",

    async execute(ctx) {

        const {
            isGroup,
            groupMetadata
        } = ctx;

        if (!isGroup)
            return Reply.error("This command can only be used in groups.");

        if (!groupMetadata)
            return Reply.error("Failed to fetch group data.");

        // Some groups (especially community-linked ones) don't expose
        // an explicit "owner" field — fall back to the first superadmin.
        const ownerId =
            groupMetadata.owner ||
            groupMetadata.participants.find(p => p.admin === "superadmin")?.id;

        if (!ownerId)
            return Reply.text("ℹ️ Couldn't determine the group owner (not exposed for this group).");

        return Reply.text(
            `👑 *Group Owner*\n\n@${ownerId.split("@")[0]}`,
            [ownerId]
        );

    }

};
